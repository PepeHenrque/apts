{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "apts",
  "version": "../package.json",
  "identifier": "io.github.pepehenrque.apts",
  "build": {
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "apts — nossa casa própria",
        "width": 480,
        "height": 880,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Quanto a família consegue financiar pela Caixa (MCMV)",
    "longDescription": "Diagnóstico, simulador de financiamento, imóveis salvos e checklists para comprar a casa própria pelo Minha Casa Minha Vida.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
