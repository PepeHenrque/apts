# Copie este arquivo para .env.local e preencha. NUNCA commite .env.local.
# Variáveis com NEXT_PUBLIC_ vão para o navegador — só coloque ali o que pode ser público.

# --- Supabase (Fase 3) ---
# Passo a passo: docs/SUPABASE.md
# URL do projeto e chave pública "publishable"/"anon" (protegida por RLS — pode ir ao navegador).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave "secret"/"service_role": ignora RLS. SOMENTE no servidor (Vercel). Nunca use NEXT_PUBLIC_.
# Usada só para o cache de geocodificação. Sem ela o app funciona igual.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (Fase 6, opcional) ---
# Se vazio, o botão "Preencher com IA" não aparece e o app funciona normalmente.
GEMINI_API_KEY=
# Modelo (opcional). Padrão: gemini-flash-latest
GEMINI_MODELO=

# --- Geocodificação (Fase 4) ---
# User-Agent identificável exigido pelo Nominatim/OpenStreetMap (ex.: "apts-app/1.0 (+https://seu-app.vercel.app)").
NOMINATIM_USER_AGENT=

# --- App de Windows (Tauri) ---
# Endereço do site na Vercel, para o app de Windows usar a IA de lá (opcional).
NEXT_PUBLIC_URL_API=
